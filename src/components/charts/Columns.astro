---
/* Vertical columns, stacked when there is more than one series. All series share one unit and one y-axis.
 * Hover any column for its values. "View as table" gives the same numbers without the chart.
 * The x geometry matches Lines.astro, so the two can stack on a shared time axis. */
import { axisLabel, colPath, FRAME, niceMax, scale, ticks } from '../../lib/charts.ts';
import { num } from '../../lib/format.ts';

export interface Series { name: string; color: string; values: number[] }
interface Props {
  buckets: { label: string; tip?: string }[];
  series: Series[];
  /** Optional per-bucket reference (e.g. climate normal), drawn as a tick across each column. */
  reference?: { name: string; values: number[] };
  unit?: string;
  height?: number;
  labelEvery?: number;
  title: string;
}
const { buckets, series, reference, unit = '', height = 190, labelEvery = 1, title } = Astro.props;

const { W, PL, PR } = FRAME;
const PT = 10, PB = 24;
const plotW = W - PL - PR, plotH = height - PT - PB;
const totals = buckets.map((_, i) => series.reduce((s, se) => s + (se.values[i] ?? 0), 0));
const max = niceMax(Math.max(0, ...totals, ...(reference?.values ?? [])));
const y = scale(max, plotH);
const step = plotW / Math.max(1, buckets.length);
const bw = Math.max(2, Math.min(28, step * 0.62));
const cx = (i: number) => PL + step * i + step / 2;
const GAP = 2; // surface gap between stacked segments

// Precompute each column's segments bottom-up so the template stays declarative.
const columns = buckets.map((b, i) => {
  let base = 0;
  const present = series.map((s, si) => ({ s, si, v: s.values[i] ?? 0 })).filter((x) => x.v > 0);
  const segs = present.map((x, k) => {
    const h = y(x.v);
    const top = PT + plotH - y(base) - h;
    base += x.v;
    const gap = k > 0 ? GAP : 0;
    return { color: x.s.color, d: colPath(cx(i) - bw / 2, top, bw, Math.max(0, h - gap), k === present.length - 1 ? 3 : 0) };
  });
  const tip = [
    b.tip ?? b.label,
    ...series.map((s) => `${s.name}: ${num(s.values[i] ?? 0)}${unit}`),
    ...(reference ? [`${reference.name}: ${num(reference.values[i] ?? 0)}${unit}`] : [])
  ].join('\n');
  const refY = reference ? PT + plotH - y(reference.values[i] ?? 0) : null;
  return { segs, tip, refY, x: cx(i) };
});
---
<figure class="chart">
  {(series.length > 1 || reference) && (
    <figcaption class="legend">
      {series.length > 1 && series.map((s) => <span><i style={`background:${s.color}`}></i>{s.name}</span>)}
      {reference && <span><i class="ref"></i>{reference.name}</span>}
    </figcaption>
  )}
  <svg viewBox={`0 0 ${W} ${height}`} role="img" aria-label={title}>
    {ticks(max).map((t) => (
      <g>
        <line x1={PL} x2={W - PR} y1={PT + plotH - y(t)} y2={PT + plotH - y(t)} class="grid" />
        <text x={PL - 6} y={PT + plotH - y(t) + 3.5} class="axis" text-anchor="end">{axisLabel(t)}</text>
      </g>
    ))}
    {columns.map((c) => (
      <g data-tip={c.tip}>
        <rect x={c.x - step / 2} y={PT} width={step} height={plotH} fill="transparent" />
        {c.segs.map((s) => <path d={s.d} fill={s.color} />)}
        {c.refY != null && <line x1={c.x - bw / 2 - 3} x2={c.x + bw / 2 + 3} y1={c.refY} y2={c.refY} class="refline" />}
      </g>
    ))}
    <line x1={PL} x2={W - PR} y1={PT + plotH} y2={PT + plotH} class="baseline" />
    {buckets.map((b, i) => (i % labelEvery === 0 ? <text x={cx(i)} y={height - 6} class="axis" text-anchor="middle">{b.label}</text> : null))}
  </svg>
  <details class="tv">
    <summary>View as table</summary>
    <div class="table-wrap"><table>
      <thead><tr><th>Period</th>{series.map((s) => <th class="num">{s.name}</th>)}{reference && <th class="num">{reference.name}</th>}</tr></thead>
      <tbody>{buckets.map((b, i) => <tr><td>{b.tip ?? b.label}</td>{series.map((s) => <td class="num">{num(s.values[i] ?? 0)}</td>)}{reference && <td class="num">{num(reference.values[i] ?? 0)}</td>}</tr>)}</tbody>
    </table></div>
  </details>
</figure>
