---
/* Schematic territory map, a placeholder for a real basemap. Each ZIP is a tile placed roughly where it sits (west
 * to the left, north at the top). It is a layout grid, not a projection.
 *   fill      → coverage completeness (one hue, dark → bright)
 *   dashed    → stale (yellow outline + clock)
 *   hatched   → never ingested (missing)
 * Tiles are links to the ZIP's properties. With JS, a click selects the tile and fills the detail card instead.
 * Swap for MapLibre + ZIP polygons when real geometry lands; the props stay the same. */
import type { CoverageArea } from '../../domain/types.ts';
import { freshness } from '../../lib/freshness.ts';
import { href } from '../../lib/filters.ts';
import { COUNTY_LABEL, num, pct, relative, SOURCE_LABEL } from '../../lib/format.ts';

interface Props { areas: CoverageArea[] }
const { areas } = Astro.props;
const { now } = Astro.locals;
const url = Astro.url;

const zips = areas.filter((a) => a.kind === 'zip');
const cols = Math.max(...zips.map((a) => a.tile.col)) + 1;
const rows = Math.max(...zips.map((a) => a.tile.row)) + 1;
const S = 92, G = 8;
const W = cols * (S + G) - G, H = rows * (S + G) - G;
const seq = (r: number) => (r >= 0.97 ? 'var(--seq-5)' : r >= 0.93 ? 'var(--seq-4)' : r >= 0.8 ? 'var(--seq-3)' : r >= 0.4 ? 'var(--seq-2)' : 'var(--seq-1)');

const tiles = zips.map((a) => {
  const completeness = a.parcelsExpected ? a.homesIndexed / a.parcelsExpected : 0;
  const f = a.homesIndexed === 0 ? 'missing' : freshness(a.lastRefreshedAt, 'coverage', now);
  const [zip, ...city] = a.name.split(' · ');
  return {
    a, zip: zip!, city: city.join(' · '), completeness, f,
    x: a.tile.col * (S + G), y: a.tile.row * (S + G),
    link: href('/properties', url, { zip }),
    detail: JSON.stringify({
      name: a.name, county: COUNTY_LABEL[a.county], homes: num(a.homesIndexed), expected: num(a.parcelsExpected), completeness: pct(completeness),
      refreshed: relative(a.lastRefreshedAt, now), freshness: f, source: a.source ? `${SOURCE_LABEL[a.source]}${a.sourceYear ? ` ${a.sourceYear}` : ''}` : 'None',
      properties: href('/properties', url, { zip }), coverage: href('/coverage', url, { area: a.id }), imp: href('/imports/new', url, { county: a.county, area: a.id })
    })
  };
});
const first = tiles.find((t) => t.f === 'stale') ?? tiles[0];
---
<div class="tmap" data-map>
  <svg viewBox={`-4 -4 ${W + 8} ${H + 8}`} role="group" aria-label="Territory coverage map by ZIP code">
    <defs>
      <pattern id="hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="8" height="8" fill="#141d2e" />
        <line x1="0" y1="0" x2="0" y2="8" stroke="#3a4a66" stroke-width="3" />
      </pattern>
    </defs>
    {tiles.map((t) => (
      <a href={t.link} data-tile={t.detail} class:list={['tile', t.f, { bright: t.f !== 'missing' && t.completeness >= 0.93, sel: t === first }]} aria-label={`${t.a.name}: ${t.f === 'missing' ? 'not ingested' : `${pct(t.completeness)} complete, ${t.f}`}`}
        data-tip={`${t.a.name}\n${t.f === 'missing' ? 'Not ingested' : `${num(t.a.homesIndexed)} homes · ${pct(t.completeness)} complete`}\nRefreshed ${relative(t.a.lastRefreshedAt, now)}`}>
        <rect x={t.x} y={t.y} width={S} height={S} rx="8" fill={t.f === 'missing' ? 'url(#hatch)' : seq(t.completeness)} />
        <text x={t.x + 9} y={t.y + 20} class="z">{t.zip}</text>
        <text x={t.x + 9} y={t.y + 36} class="c">{t.city.length > 14 ? `${t.city.slice(0, 13)}…` : t.city}</text>
        <text x={t.x + 9} y={t.y + S - 12} class="p">{t.f === 'missing' ? 'No data' : pct(t.completeness)}</text>
        {t.f === 'stale' && <g transform={`translate(${t.x + S - 22} ${t.y + 8})`} class="clock"><circle cx="7" cy="7" r="6.5" /><path d="M7 3.5V7l2.3 1.5" /></g>}
      </a>
    ))}
  </svg>

  <aside class="card" aria-live="polite">
    <div data-card>
      {first && (() => {
        const d = JSON.parse(first.detail);
        return (
          <>
            <h3>{d.name}</h3>
            <dl>
              <dt>County</dt><dd>{d.county}</dd>
              <dt>Homes indexed</dt><dd>{d.homes} of ~{d.expected}</dd>
              <dt>Completeness</dt><dd>{d.completeness}</dd>
              <dt>Refreshed</dt><dd>{d.refreshed}</dd>
              <dt>Source</dt><dd>{d.source}</dd>
            </dl>
            <div class="links"><a href={d.properties}>Properties →</a><a href={d.coverage}>Coverage →</a></div>
          </>
        );
      })()}
    </div>
    <ul class="key">
      <li><i style="background:var(--seq-5)"></i>≥ 97% complete</li>
      <li><i style="background:var(--seq-4)"></i>93–97%</li>
      <li><i style="background:var(--seq-3)"></i>80–93%</li>
      <li><i style="background:var(--seq-2)"></i>40–80%</li>
      <li><i style="background:var(--seq-1)"></i>&lt; 40%</li>
      <li><i class="k-stale"></i>Stale (dashed)</li>
      <li><i class="k-missing"></i>Not ingested</li>
    </ul>
  </aside>
</div>

<script>
  // Progressive enhancement: a click selects the tile and fills the detail card. Links still work without JS.
  for (const map of document.querySelectorAll<HTMLElement>('[data-map]')) {
    const card = map.querySelector<HTMLElement>('[data-card]')!;
    map.addEventListener('click', (e) => {
      const tile = (e.target as Element).closest<SVGAElement>('[data-tile]');
      if (!tile || e.metaKey || e.ctrlKey) return;
      e.preventDefault();
      map.querySelectorAll('.tile.sel').forEach((t) => t.classList.remove('sel'));
      tile.classList.add('sel');
      const d = JSON.parse(tile.dataset.tile!);
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
      card.innerHTML = `<h3>${esc(d.name)}</h3><dl>
        <dt>County</dt><dd>${esc(d.county)}</dd>
        <dt>Homes indexed</dt><dd>${esc(d.homes)} of ~${esc(d.expected)}</dd>
        <dt>Completeness</dt><dd>${d.freshness === 'missing' ? 'Not ingested' : esc(d.completeness)}</dd>
        <dt>Refreshed</dt><dd>${esc(d.refreshed)}</dd>
        <dt>Source</dt><dd>${esc(d.source)}</dd></dl>
        <div class="links">${d.freshness === 'missing' ? `<a href="${esc(d.imp)}">Plan an import →</a>` : `<a href="${esc(d.properties)}">Properties →</a>`}<a href="${esc(d.coverage)}">Coverage →</a></div>`;
    });
  }
</script>

<style>
  .tmap { display: grid; grid-template-columns: minmax(0, 1fr) 200px; gap: 16px; align-items: start; }
  svg { width: 100%; height: auto; max-height: 440px; }
  .tile rect { stroke: rgba(255, 255, 255, 0.06); stroke-width: 1; transition: stroke 0.1s; }
  .tile:hover rect, .tile:focus rect { stroke: var(--text-1); stroke-width: 2; }
  .tile.sel rect { stroke: var(--accent); stroke-width: 2.5; filter: drop-shadow(0 0 6px rgba(3, 188, 230, 0.6)); }
  .tile.stale rect { stroke: var(--warn); stroke-dasharray: 5 4; stroke-width: 1.5; }
  .tile:focus { outline: none; }
  .z { fill: #fff; font: 700 14px var(--font); }
  .c { fill: rgba(255, 255, 255, 0.82); font: 500 11px var(--font); }
  .p { fill: #fff; font: 700 13px var(--font); }
  .missing .z, .missing .c, .missing .p { fill: var(--text-2); }
  /* Bright tiles take dark ink: white on the top two steps falls under 3:1. */
  .bright .z, .bright .p { fill: #04121c; }
  .bright .c { fill: rgba(4, 18, 28, 0.85); }
  .clock { fill: #1b1400; stroke: var(--warn); stroke-width: 1.4; stroke-linecap: round; }
  .card { background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px; padding: 12px; font-size: 12.5px; display: grid; gap: 12px; }
  .card :global(h3) { font-size: 13.5px; margin-bottom: 8px; }
  .card :global(dl) { display: grid; grid-template-columns: auto 1fr; gap: 4px 10px; margin: 0; }
  .card :global(dt) { color: var(--text-3); }
  .card :global(dd) { margin: 0; text-align: right; }
  .card :global(.links) { display: flex; justify-content: space-between; margin-top: 10px; }
  .key { list-style: none; margin: 0; padding: 10px 0 0; border-top: 1px solid var(--border); display: grid; gap: 5px; color: var(--text-2); font-size: 11.5px; }
  .key li { display: flex; gap: 8px; align-items: center; }
  .key i { width: 14px; height: 14px; border-radius: 3px; display: inline-block; }
  .k-stale { border: 1.5px dashed var(--warn); }
  .k-missing { background: repeating-linear-gradient(45deg, #141d2e 0 3px, #3a4a66 3px 5px); }
  @media (max-width: 700px) { .tmap { grid-template-columns: minmax(0, 1fr); } }
</style>
