---
/* The authenticated dashboard shell: sidebar navigation, the global filter bar, the mock-data and stub-session
 * banners, and the shared chart tooltip. Every page renders inside it. */
import '../../styles/global.css';
import { href, PROPERTY_SOURCES, RANGES, readGlobalFilters } from '../../lib/filters.ts';
import Icon from '../ui/Icon.astro';

interface Props {
  title: string;
  /** One line under the title: what question this page answers. */
  question?: string;
  /** Hide filters that don't apply to this page. */
  filters?: { territory?: boolean; range?: boolean; source?: boolean };
}
const { title, question, filters = { territory: true, range: true, source: true } } = Astro.props;
const { url, locals } = Astro;
const { user, repos } = locals;
const g = readGlobalFilters(url);

let territories: { id: string; name: string }[] = [];
try {
  territories = (await repos.coverage.list({ kind: 'township' })).map((a) => ({ id: a.id, name: a.name }));
} catch {
  // The filter bar should never take the page down. With no list, the territory menu offers "All" only.
}

// Grouped by job, like the sidebar of a well-run ops tool. Group labels hide at phone width, where the nav is one strip.
const NAV_GROUPS = [
  { label: 'Intelligence', items: [
    { path: '/', label: 'Overview', icon: 'overview' },
    { path: '/properties', label: 'Properties', icon: 'home' },
    { path: '/markets', label: 'Market Intelligence', icon: 'chart' },
    { path: '/weather', label: 'Weather Intelligence', icon: 'weather' }
  ] },
  { label: 'Data operations', items: [
    { path: '/coverage', label: 'Data Coverage', icon: 'map' },
    { path: '/imports', label: 'Imports', icon: 'import' },
    { path: '/quality', label: 'Data Quality', icon: 'shield' }
  ] },
  { label: 'Growth', items: [{ path: '/seo', label: 'SEO & AEO', icon: 'globe' }] },
  { label: 'Platform', items: [{ path: '/projects', label: 'Projects & API', icon: 'key' }] }
] as const;
// The SEO pages have their own data source (SEO_DATA_SOURCE), so the mock banner and footer follow it there.
const onSeo = url.pathname === '/seo' || url.pathname.startsWith('/seo/');
const dataKind = onSeo ? repos.seo.kind : repos.kind;
const isActive = (p: string) => (p === '/' ? url.pathname === '/' : url.pathname === p || url.pathname.startsWith(`${p}/`));

// Page-specific params survive a filter change. `page` doesn't, because the result set changes.
const carry = [...url.searchParams].filter(([k]) => !['territory', 'range', 'source', 'page'].includes(k));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · ARR Intelligence Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2314284e'/%3E%3Cpath d='M16 6 25 26h-4l-5-11-5 11H7z' fill='%2303bce6'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="app">
      <aside class="side" aria-label="Primary">
        <a class="brand" href={href('/', url)}>
          <span class="mark" aria-hidden="true">
            <svg viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="#14284e" /><path d="M16 6 25 26h-4l-5-11-5 11H7z" fill="#03bce6" /><path d="M11.5 22h9" stroke="#ee292f" stroke-width="2.4" /></svg>
          </span>
          <span><strong>ARR</strong> Intelligence Hub</span>
        </a>
        <nav aria-label="Sections">
          {NAV_GROUPS.map((grp) => (
            <div class="grp">
              <span class="grp-label">{grp.label}</span>
              {grp.items.map((n) => (
                <a href={href(n.path, url)} class:list={['nav', { on: isActive(n.path) }]} aria-current={isActive(n.path) ? 'page' : undefined}>
                  <Icon name={n.icon} size={16} />
                  <span>{n.label}</span>
                </a>
              ))}
            </div>
          ))}
        </nav>
        <div class="side-foot">
          <div class="who">
            <span class="avatar" aria-hidden="true">{user.name.slice(0, 1)}</span>
            <span><strong>{user.name}</strong><br /><span class="muted small">{user.role}</span></span>
          </div>
        </div>
      </aside>

      <div class="main-col">
        {(dataKind === 'mock' || user.stub) && (
          <div class="classif" role="note" aria-label="Environment notice">
            {dataKind === 'mock' && <span><Icon name="flask" size={13} /> <strong>Mock data</strong><span class="why"> // synthetic, for layout only. None of it is ARR's.</span></span>}
            {user.stub && <span><Icon name="lock" size={13} /> <strong>No authentication</strong><span class="why"> // dev stub. Don't deploy before Supabase Auth.</span></span>}
          </div>
        )}
        <header class="topbar">
          <form class="filters" method="get" action={url.pathname} data-autosubmit>
            {carry.map(([k, v]) => <input type="hidden" name={k} value={v} />)}
            {filters.territory && (
              <label class="f"><span>Territory</span>
                <select name="territory">
                  <option value="">All territories</option>
                  {territories.map((t) => <option value={t.id} selected={g.territory === t.id}>{t.name}</option>)}
                </select>
              </label>
            )}
            {filters.range && (
              <label class="f"><span>Date range</span>
                <select name="range">
                  {RANGES.map((r) => <option value={r.key} selected={g.range === r.key}>{r.label}</option>)}
                </select>
              </label>
            )}
            {filters.source && (
              <label class="f"><span>Data source</span>
                <select name="source">
                  <option value="">All sources</option>
                  {PROPERTY_SOURCES.map((s) => <option value={s.key} selected={g.source === s.key}>{s.label}</option>)}
                </select>
              </label>
            )}
            <noscript><button class="btn" type="submit">Apply</button></noscript>
          </form>
          <form class="search" method="get" action="/properties" role="search">
            <label class="visually-hidden" for="hub-search">Search properties by address or PIN</label>
            <Icon name="search" size={15} />
            <input id="hub-search" type="search" name="q" placeholder="Address or PIN" value={url.pathname === '/properties' ? (url.searchParams.get('q') ?? '') : ''} />
          </form>
        </header>

        <main id="main">
          <div class="page-head">
            <div>
              <h1>{title}</h1>
              {question && <p class="question">{question}</p>}
            </div>
            <div class="page-actions"><slot name="actions" /></div>
          </div>
          <slot />
        </main>
        <footer class="foot muted small">
          <span>ARR Heating + Cooling · Intelligence Hub v0.1</span>
          <span class="mono">SRC/{dataKind.toUpperCase()}</span>
        </footer>
      </div>
    </div>
    <div id="hub-tip" role="tooltip" aria-hidden="true"></div>

    <script>
      // Filters apply as soon as a select changes. Without JS, the <noscript> Apply button does the same.
      for (const form of document.querySelectorAll<HTMLFormElement>('form[data-autosubmit]')) {
        form.addEventListener('change', () => form.requestSubmit());
      }

      // One tooltip for every chart mark carrying data-tip. Covers pointer hover and keyboard focus.
      const tip = document.getElementById('hub-tip')!;
      const show = (el: Element, x: number, y: number) => {
        tip.textContent = el.getAttribute('data-tip');
        tip.classList.add('on');
        const w = tip.offsetWidth, h = tip.offsetHeight;
        tip.style.left = `${Math.min(window.innerWidth - w - 8, Math.max(8, x - w / 2))}px`;
        tip.style.top = `${y - h - 12 < 8 ? y + 16 : y - h - 12}px`;
      };
      const hide = () => tip.classList.remove('on');
      document.addEventListener('pointermove', (e) => {
        const el = (e.target as Element | null)?.closest?.('[data-tip]');
        if (el) show(el, e.clientX, e.clientY); else hide();
      });
      document.addEventListener('focusin', (e) => {
        const el = (e.target as Element).closest('[data-tip]');
        if (!el) return hide();
        const r = el.getBoundingClientRect();
        show(el, r.left + r.width / 2, r.top);
      });
      document.addEventListener('focusout', hide);
      document.addEventListener('scroll', hide, { passive: true });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--surface-2); padding: 8px 12px; border-radius: var(--radius-sm); z-index: 60; }
  .skip:focus { left: 8px; }
  .app { display: grid; grid-template-columns: 236px minmax(0, 1fr); min-height: 100vh; }

  /* Sidebar: the darkest surface, flat. The active item gets a lighter fill and a 2px accent bar, nothing else. */
  .side {
    position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; gap: 14px; padding: 16px 10px;
    background: var(--bg-0); border-right: 1px solid var(--border); overflow-y: auto;
  }
  .brand { display: flex; align-items: center; gap: 10px; padding: 4px 8px 8px; color: var(--text-1); font-size: var(--fs-md); line-height: 1.2; }
  .brand:hover { text-decoration: none; }
  .brand strong { font-weight: 700; letter-spacing: 0.02em; }
  .mark svg { width: 30px; height: 30px; display: block; }
  nav { display: grid; gap: 14px; }
  .grp { display: grid; gap: 1px; }
  .grp-label { font: 500 11px/1.4 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); padding: 0 10px 4px; }
  .nav {
    display: flex; align-items: center; gap: 10px; min-height: 34px; padding: 0 10px; border-radius: var(--radius-sm);
    color: var(--text-2); font-weight: 500; font-size: var(--fs-sm); border-left: 2px solid transparent;
  }
  .nav :global(svg) { color: var(--text-3); }
  .nav:hover { background: var(--surface-1); color: var(--text-1); text-decoration: none; }
  .nav.on { background: var(--surface-3); color: var(--text-1); border-left-color: var(--accent); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .nav.on :global(svg) { color: var(--accent); }
  .side-foot { margin-top: auto; border-top: 1px solid var(--border); padding: 12px 8px 0; }
  .who { display: flex; gap: 10px; align-items: center; font-size: var(--fs-sm); line-height: 1.3; }
  .avatar { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--surface-3); color: var(--text-1); font-weight: 600; font-size: var(--fs-sm); }

  .main-col { display: flex; flex-direction: column; min-width: 0; }

  /* Classification strip: the environment notice reads like a document marking, not a page-wide alarm. */
  .classif {
    display: flex; flex-wrap: wrap; gap: 4px 28px; padding: 6px 24px; font: 400 var(--fs-xs)/1.5 var(--mono);
    color: var(--warn); background: #171303; border-bottom: 1px solid rgba(255, 204, 4, 0.35);
  }
  .classif > span { display: inline-flex; align-items: center; gap: 7px; }
  .classif .why { white-space: pre-wrap; }
  .classif strong { font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; }

  .topbar {
    position: sticky; top: 0; z-index: 20; display: flex; gap: 10px 16px; align-items: center; justify-content: space-between; flex-wrap: wrap;
    padding: 10px 24px; background: rgba(11, 20, 34, 0.9); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border);
  }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  /* Inline-label control: "TERRITORY  All territories ▾" in one bordered box. */
  .f {
    display: flex; align-items: center; gap: 0; min-width: 0; background: var(--surface-2); border: 1px solid var(--input);
    border-radius: var(--radius-sm); padding-left: 10px;
  }
  .f:hover { border-color: #6a86b0; }
  .f:focus-within { outline: 2px solid var(--accent); outline-offset: 1px; }
  .f span { font: 500 11px/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); white-space: nowrap; }
  .f select { border: 0; background: transparent; min-height: 32px; width: auto; max-width: 200px; padding: 4px 8px; font-weight: 500; }
  .f select:focus-visible { outline: none; }
  .search { position: relative; display: flex; align-items: center; min-width: 240px; }
  .search :global(svg) { position: absolute; left: 10px; color: var(--text-3); }
  .search input { padding-left: 32px; }
  main { padding: 24px 24px 32px; display: grid; gap: 16px; align-content: start; max-width: 1600px; width: 100%; }
  main > :global(*) { min-width: 0; }
  .page-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px 16px; flex-wrap: wrap; margin-bottom: 4px; }
  .question { color: var(--text-2); margin-top: 6px; max-width: 72ch; }
  .page-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .foot { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 12px 24px 24px; }

  /* Phone and narrow tablet: the sidebar becomes a brand row plus one scrollable nav strip. */
  @media (max-width: 900px) {
    .app { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; height: auto; padding: 10px 0 0; gap: 6px; border-right: 0; border-bottom: 1px solid var(--border); overflow: visible; }
    .brand { padding: 0 16px 4px; }
    nav { display: flex; gap: 2px; overflow-x: auto; padding: 0 12px 8px; scrollbar-width: none; scroll-snap-type: x proximity; }
    nav::-webkit-scrollbar { display: none; }
    .grp { display: contents; }
    .grp-label { display: none; }
    .nav { flex: none; white-space: nowrap; scroll-snap-align: start; border-left: 0; border-bottom: 2px solid transparent; border-radius: var(--radius-sm) var(--radius-sm) 0 0; }
    .nav.on { border-bottom-color: var(--accent); border-radius: var(--radius-sm) var(--radius-sm) 0 0; }
    .side-foot { display: none; }
    .classif { padding: 6px 16px; gap: 2px 16px; }
    .classif .why { display: none; }
    .topbar { position: static; padding: 10px 16px; }
    .filters { flex-wrap: nowrap; overflow-x: auto; width: 100%; scrollbar-width: none; }
    .filters::-webkit-scrollbar { display: none; }
    .f { flex: none; }
    .search { min-width: 0; flex: 1 1 100%; }
    main { padding: 16px; }
    h1 { font-size: 22px; }
  }
</style>
