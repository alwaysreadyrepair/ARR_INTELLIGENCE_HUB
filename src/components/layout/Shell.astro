---
/* The authenticated dashboard shell: sidebar navigation, the global filter bar, the mock-data and stub-session
 * banners, and the shared chart tooltip. Every page renders inside it. */
import '../../styles/global.css';
import { href, PROPERTY_SOURCES, RANGES, readGlobalFilters } from '../../lib/filters.ts';
import Icon from '../ui/Icon.astro';

interface Props {
  title: string;
  /** One line under the title: what question this page answers. */
  question?: string;
  /** Hide filters that don't apply to this page. */
  filters?: { territory?: boolean; range?: boolean; source?: boolean };
}
const { title, question, filters = { territory: true, range: true, source: true } } = Astro.props;
const { url, locals } = Astro;
const { user, repos } = locals;
const g = readGlobalFilters(url);

let territories: { id: string; name: string }[] = [];
try {
  territories = (await repos.coverage.list({ kind: 'township' })).map((a) => ({ id: a.id, name: a.name }));
} catch {
  // The filter bar should never take the page down. With no list, the territory menu offers "All" only.
}

const NAV = [
  { path: '/', label: 'Overview', icon: 'overview' },
  { path: '/properties', label: 'Properties', icon: 'home' },
  { path: '/markets', label: 'Market Intelligence', icon: 'chart' },
  { path: '/weather', label: 'Weather Intelligence', icon: 'weather' },
  { path: '/coverage', label: 'Data Coverage', icon: 'map' },
  { path: '/imports', label: 'Imports', icon: 'import' },
  { path: '/quality', label: 'Data Quality', icon: 'shield' },
  { path: '/seo', label: 'SEO & AEO', icon: 'globe' },
  { path: '/traffic', label: 'Web Traffic', icon: 'pulse' },
  { path: '/projects', label: 'Projects & API', icon: 'key' }
] as const;
// The SEO and Web Traffic pages have their own data sources (SEO_DATA_SOURCE, TRAFFIC_DATA_SOURCE), so the mock
// banner and footer follow them there.
const under = (p: string) => url.pathname === p || url.pathname.startsWith(`${p}/`);
const dataKind = under('/seo') ? repos.seo.kind : under('/traffic') ? repos.traffic.kind : repos.kind;
const isActive = (p: string) => (p === '/' ? url.pathname === '/' : url.pathname === p || url.pathname.startsWith(`${p}/`));

// Page-specific params survive a filter change. `page` doesn't, because the result set changes.
const carry = [...url.searchParams].filter(([k]) => !['territory', 'range', 'source', 'page'].includes(k));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · ARR Intelligence Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2314284e'/%3E%3Cpath d='M16 6 25 26h-4l-5-11-5 11H7z' fill='%2303bce6'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="app">
      <aside class="side" aria-label="Primary">
        <a class="brand" href={href('/', url)}>
          <span class="mark" aria-hidden="true">
            <svg viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="#14284e" /><path d="M16 6 25 26h-4l-5-11-5 11H7z" fill="#03bce6" /><path d="M11.5 22h9" stroke="#ee292f" stroke-width="2.4" /></svg>
          </span>
          <span><strong>ARR</strong> Intelligence Hub</span>
        </a>
        <nav>
          {NAV.map((n) => (
            <a href={href(n.path, url)} class:list={['nav', { on: isActive(n.path) }]} aria-current={isActive(n.path) ? 'page' : undefined}>
              <Icon name={n.icon} />
              <span>{n.label}</span>
            </a>
          ))}
        </nav>
        <div class="side-foot">
          <div class="who">
            <span class="avatar" aria-hidden="true">{user.name.slice(0, 1)}</span>
            <span><strong>{user.name}</strong><br /><span class="muted small">{user.role}</span></span>
          </div>
        </div>
      </aside>

      <div class="main-col">
        {(dataKind === 'mock' || user.stub) && (
          <div class="banner" role="note">
            {dataKind === 'mock' && <span><Icon name="flask" size={14} /> <strong>Mock data.</strong> Every number here is synthetic, generated for layout. Nothing is ARR's.</span>}
            {user.stub && <span><Icon name="lock" size={14} /> <strong>No authentication.</strong> Dev session stub. Don't deploy until Supabase Auth is in.</span>}
          </div>
        )}
        <header class="topbar">
          <form class="filters" method="get" action={url.pathname} data-autosubmit>
            {carry.map(([k, v]) => <input type="hidden" name={k} value={v} />)}
            {filters.territory && (
              <label class="f"><span>Territory</span>
                <select name="territory">
                  <option value="">All territories</option>
                  {territories.map((t) => <option value={t.id} selected={g.territory === t.id}>{t.name}</option>)}
                </select>
              </label>
            )}
            {filters.range && (
              <label class="f"><span>Date range</span>
                <select name="range">
                  {RANGES.map((r) => <option value={r.key} selected={g.range === r.key}>{r.label}</option>)}
                </select>
              </label>
            )}
            {filters.source && (
              <label class="f"><span>Data source</span>
                <select name="source">
                  <option value="">All sources</option>
                  {PROPERTY_SOURCES.map((s) => <option value={s.key} selected={g.source === s.key}>{s.label}</option>)}
                </select>
              </label>
            )}
            <noscript><button class="btn" type="submit">Apply</button></noscript>
          </form>
          <form class="search" method="get" action="/properties" role="search">
            <label class="visually-hidden" for="hub-search">Search properties by address or PIN</label>
            <Icon name="search" size={15} />
            <input id="hub-search" type="search" name="q" placeholder="Address or PIN" value={url.pathname === '/properties' ? (url.searchParams.get('q') ?? '') : ''} />
          </form>
        </header>

        <main id="main">
          <div class="page-head">
            <div>
              <h1>{title}</h1>
              {question && <p class="question">{question}</p>}
            </div>
            <div class="page-actions"><slot name="actions" /></div>
          </div>
          <slot />
        </main>
        <footer class="foot muted small">
          ARR Heating + Cooling · Intelligence Hub v0.1 · data source: <span class="mono">{dataKind}</span>
        </footer>
      </div>
    </div>
    <div id="hub-tip" role="tooltip" aria-hidden="true"></div>

    <script>
      // Filters apply as soon as a select changes. Without JS, the <noscript> Apply button does the same.
      for (const form of document.querySelectorAll<HTMLFormElement>('form[data-autosubmit]')) {
        form.addEventListener('change', () => form.requestSubmit());
      }

      // One tooltip for every chart mark carrying data-tip. Covers pointer hover and keyboard focus.
      const tip = document.getElementById('hub-tip')!;
      const show = (el: Element, x: number, y: number) => {
        tip.textContent = el.getAttribute('data-tip');
        tip.classList.add('on');
        const w = tip.offsetWidth, h = tip.offsetHeight;
        tip.style.left = `${Math.min(window.innerWidth - w - 8, Math.max(8, x - w / 2))}px`;
        tip.style.top = `${y - h - 12 < 8 ? y + 16 : y - h - 12}px`;
      };
      const hide = () => tip.classList.remove('on');
      document.addEventListener('pointermove', (e) => {
        const el = (e.target as Element | null)?.closest?.('[data-tip]');
        if (el) show(el, e.clientX, e.clientY); else hide();
      });
      document.addEventListener('focusin', (e) => {
        const el = (e.target as Element).closest('[data-tip]');
        if (!el) return hide();
        const r = el.getBoundingClientRect();
        show(el, r.left + r.width / 2, r.top);
      });
      document.addEventListener('focusout', hide);
      document.addEventListener('scroll', hide, { passive: true });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--surface-2); padding: 8px 12px; border-radius: 6px; z-index: 60; }
  .skip:focus { left: 8px; }
  .app { display: grid; grid-template-columns: 236px minmax(0, 1fr); min-height: 100vh; }
  .side {
    position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; gap: 18px; padding: 18px 12px;
    background: linear-gradient(180deg, rgba(20, 40, 78, 0.55), rgba(10, 18, 32, 0.8)); border-right: 1px solid var(--border);
    backdrop-filter: blur(6px);
  }
  .brand { display: flex; align-items: center; gap: 10px; padding: 4px 8px; color: var(--text-1); font-size: 14px; line-height: 1.2; }
  .brand:hover { text-decoration: none; }
  .brand strong { font: 800 15px var(--font-display); font-stretch: expanded; letter-spacing: 0.04em; }
  .mark svg { width: 32px; height: 32px; display: block; }
  nav { display: grid; gap: 2px; }
  .nav { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 8px; color: var(--text-2); font-weight: 500; position: relative; }
  .nav:hover { background: rgba(255, 255, 255, 0.04); color: var(--text-1); text-decoration: none; }
  .nav.on { background: var(--accent-dim); color: var(--text-1); }
  .nav.on::before { content: ''; position: absolute; left: -12px; top: 8px; bottom: 8px; width: 3px; border-radius: 0 3px 3px 0; background: var(--accent); box-shadow: 0 0 12px var(--accent); }
  .nav.on :global(svg) { color: var(--accent); }
  .side-foot { margin-top: auto; border-top: 1px solid var(--border); padding: 14px 8px 0; }
  .who { display: flex; gap: 10px; align-items: center; font-size: 13px; line-height: 1.3; }
  .avatar { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--arr-blue); font-weight: 700; }

  .main-col { display: flex; flex-direction: column; min-width: 0; }
  .banner { display: flex; flex-wrap: wrap; gap: 6px 24px; padding: 7px 24px; font-size: 12.5px; color: #1b1400; background: var(--warn); }
  .banner span { display: inline-flex; align-items: center; gap: 6px; }
  .topbar {
    position: sticky; top: 0; z-index: 20; display: flex; gap: 16px; align-items: flex-end; justify-content: space-between; flex-wrap: wrap;
    padding: 12px 24px; background: rgba(10, 18, 32, 0.86); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border);
  }
  .filters { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; }
  .f { min-width: 170px; }
  .f span { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); }
  .search { position: relative; display: flex; align-items: center; min-width: 240px; }
  .search :global(svg) { position: absolute; left: 10px; color: var(--text-3); }
  .search input { padding-left: 32px; }
  main { padding: 22px 24px 32px; display: grid; gap: 16px; align-content: start; }
  main > :global(*) { min-width: 0; }
  .page-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 2px; }
  .question { color: var(--text-2); margin-top: 6px; max-width: 70ch; }
  .page-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .foot { padding: 12px 24px 24px; }

  @media (max-width: 900px) {
    .app { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; height: auto; flex-direction: column; padding: 12px; }
    nav { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .nav.on::before { display: none; }
    .side-foot { display: none; }
    .topbar { position: static; padding: 12px 16px; }
    main { padding: 16px; }
    .banner { padding: 7px 16px; }
    .f, .search { min-width: 0; flex: 1 1 150px; }
  }
</style>
