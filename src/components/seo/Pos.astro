---
/* A search position with its change since the last refresh. Up the page is better, so a positive delta is good. */
interface Props { position: number | null; delta?: number | null; muted?: boolean }
const { position, delta, muted } = Astro.props;
const tone = position == null ? 'none' : position <= 3 ? 'top3' : position <= 10 ? 'top10' : 'deep';
const label = position == null ? 'Not ranked' : `Position ${position}`;
const change = delta == null || delta === 0 ? '' : delta > 0 ? `, up ${delta}` : `, down ${-delta}`;
---
<span class:list={['pos', tone, { muted }]} title={label + change}>
  <span class="v">{position ?? '—'}</span>
  {delta != null && delta !== 0 && <span class:list={['d', delta > 0 ? 'up' : 'down']} aria-hidden="true">{delta > 0 ? '▲' : '▼'}{Math.abs(delta)}</span>}
  <span class="visually-hidden">{label + change}</span>
</span>

<style>
  .pos { display: inline-flex; align-items: baseline; gap: 4px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .v { display: inline-block; min-width: 26px; text-align: center; padding: 1px 6px; border-radius: 5px; font-weight: 650; font-size: 12.5px; }
  .top3 .v { background: rgba(3, 188, 230, 0.2); color: var(--text-1); box-shadow: inset 0 0 0 1px rgba(3, 188, 230, 0.55); }
  .top10 .v { background: rgba(3, 188, 230, 0.08); color: var(--text-1); }
  .deep .v { color: var(--text-2); }
  .none .v { color: var(--text-3); }
  .d { font-size: 10.5px; font-weight: 600; }
  .up { color: var(--good); }
  .down { color: var(--serious); }
  .muted { opacity: 0.6; }
</style>
