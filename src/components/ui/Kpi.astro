---
/* A headline number. The value is the chart here, so there's no plot. `detail` says what the number is
 * made of, so it can be checked. */
import Status from './Status.astro';

interface Props {
  label: string;
  value: string;
  detail?: string;
  status?: string;
  statusLabel?: string;
  href?: string;
  /** For a failed load: show the label with an em dash and this reason in place of the detail. */
  error?: string;
  /** 'sm' for a secondary strip of supporting numbers under the headline KPIs. */
  size?: 'md' | 'sm';
}
const { label, value, detail, status, statusLabel, href, error, size = 'md' } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['kpi', size, { link: href }]} href={href}>
  <span class="label">{label}</span>
  <span class:list={['value', { long: !error && value.length > 9 }]}>{error ? '—' : value}</span>
  {error ? <span class="detail err">{error}</span> : detail && <span class="detail">{detail}</span>}
  {status && !error && <span class="st"><Status value={status} label={statusLabel} /></span>}
</Tag>

<style>
  .kpi {
    position: relative; display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; border-radius: var(--radius);
    background: var(--surface-1); border: 1px solid var(--border); color: var(--text-1); min-width: 0;
  }
  .link:hover { border-color: var(--border-strong); background: var(--surface-2); text-decoration: none; }
  .link:hover .label { color: var(--text-2); }
  .label { font: 500 var(--fs-xs)/1.4 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); }
  .value { font: 650 var(--fs-kpi)/1.15 var(--font); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .value.long { font-size: 22px; line-height: 1.25; }
  .detail { font-size: var(--fs-sm); color: var(--text-2); }
  .err { color: var(--critical); }
  .st { margin-top: 4px; }

  /* Secondary strip: label and value on one baseline, detail underneath. */
  .sm { padding: 10px 14px; gap: 2px; }
  .sm .value { font-size: 20px; }
  .sm .value.long { font-size: 17px; }
  .sm .detail { font-size: var(--fs-xs); color: var(--text-3); }
</style>
