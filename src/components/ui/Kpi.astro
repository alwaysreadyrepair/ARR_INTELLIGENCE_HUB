---
/* A headline number. The value is the chart here, so there's no plot. `detail` says what the number is
 * made of, so it can be checked. */
import Status from './Status.astro';

interface Props {
  label: string;
  value: string;
  detail?: string;
  status?: string;
  statusLabel?: string;
  href?: string;
  /** For a failed load: show the label with an em dash and this reason in place of the detail. */
  error?: string;
}
const { label, value, detail, status, statusLabel, href, error } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['kpi', { link: href }]} href={href}>
  <span class="label">{label}</span>
  <span class:list={['value', { long: !error && value.length > 9 }]}>{error ? '—' : value}</span>
  {error ? <span class="detail err">{error}</span> : detail && <span class="detail">{detail}</span>}
  {status && !error && <span class="st"><Status value={status} label={statusLabel} /></span>}
</Tag>

<style>
  .kpi {
    position: relative; display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; border-radius: var(--radius);
    background: linear-gradient(160deg, rgba(8, 78, 145, 0.28), rgba(16, 27, 46, 0.95) 55%), var(--surface-1);
    border: 1px solid var(--border); color: var(--text-1); min-width: 0; overflow: hidden;
  }
  .kpi::after { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 2px; background: linear-gradient(90deg, var(--accent), transparent 70%); opacity: 0.7; }
  .link:hover { border-color: var(--border-strong); text-decoration: none; background-color: var(--surface-2); }
  .label { font-size: 11.5px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-3); font-weight: 600; }
  .value { font: 800 28px/1.1 var(--font-display); font-stretch: expanded; letter-spacing: 0.005em; font-variant-numeric: tabular-nums; }
  .value.long { font-size: 21px; line-height: 1.2; }
  .detail { font-size: 12.5px; color: var(--text-2); }
  .err { color: var(--critical); }
  .st { margin-top: 4px; }
</style>
