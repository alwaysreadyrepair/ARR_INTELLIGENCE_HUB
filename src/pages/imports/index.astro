---
import Shell from '../../components/layout/Shell.astro';
import Panel from '../../components/ui/Panel.astro';
import Status from '../../components/ui/Status.astro';
import Icon from '../../components/ui/Icon.astro';
import { load, hasData } from '../../lib/load.ts';
import { newest } from '../../lib/freshness.ts';
import { enumParam, href } from '../../lib/filters.ts';
import { dateTime, num, pct, relative, SOURCE_LABEL } from '../../lib/format.ts';
import { ratio } from '../../lib/stats.ts';
import type { JobStatus } from '../../domain/types.ts';

const { repos, now, simulate } = Astro.locals;
const url = Astro.url;
const STATUSES = ['running', 'queued', 'succeeded', 'partial', 'failed', 'cancelled'] as const satisfies readonly JobStatus[];
const status = enumParam(url, 'status', STATUSES);
const focus = url.searchParams.get('job');

const [jobs, areas] = await Promise.all([
  load(() => repos.ingestion.list({ status }), { simulate, now, asOf: (j) => newest(j.map((x) => x.finishedAt ?? x.startedAt ?? x.createdAt)) }),
  repos.coverage.list({ kind: 'township' }).catch(() => [])
]);
const areaName = (id: string) => areas.find((a) => a.id === id)?.name.replace(' Township', '') ?? id;
const duration = (a: string | null, b: string | null) => (a && b ? `${Math.max(1, Math.round((Date.parse(b) - Date.parse(a)) / 60_000))} min` : '—');
---
<Shell title="Imports" question="What's being pulled in, what landed, and what got rejected and why." filters={{}}>
  <a slot="actions" class="btn primary" href={href('/imports/new', url)}><Icon name="import" size={15} /> New import</a>

  <nav class="chips" aria-label="Filter by status">
    <a class:list={{ on: !status }} href={href('/imports', url)}>All</a>
    {STATUSES.map((s) => <a class:list={{ on: status === s }} href={href('/imports', url, { status: s })}>{s[0]!.toUpperCase() + s.slice(1)}</a>)}
  </nav>

  <Panel title="Ingestion jobs" subtitle="Newest first. Expand a job for its record counts and rejected samples." result={jobs} source="Ingestion log" emptyText={status ? `No ${status} jobs.` : 'No imports yet. Start one with New import.'}>
    <ul class="jobs">
      {hasData(jobs) && jobs.data.map((j) => {
        const progress = j.recordsExpected ? ratio(j.recordsProcessed, j.recordsExpected) : null;
        return (
          <li>
            <details open={focus === j.id || j.status === 'running'} id={j.id}>
              <summary>
                <Status value={j.status} />
                <span class="mono">{j.id}</span>
                <span class="what">{SOURCE_LABEL[j.source]} · {j.areaIds.map(areaName).join(', ')}{j.dryRun && <span class="tag">Dry run</span>}</span>
                <span class="muted small when">{relative(j.finishedAt ?? j.startedAt ?? j.createdAt, now)}</span>
              </summary>
              <div class="detail">
                {progress != null && (
                  <div class="prog" role="progressbar" aria-valuenow={Math.round(progress * 100)} aria-valuemin={0} aria-valuemax={100} aria-label="Records processed">
                    <span style={`width:${progress * 100}%`}></span>
                  </div>
                )}
                <dl>
                  <dt>Processed</dt><dd>{num(j.recordsProcessed)}{j.recordsExpected ? ` of ${num(j.recordsExpected)} (${pct(progress)})` : ''}</dd>
                  <dt>Accepted</dt><dd>{num(j.recordsAccepted)}</dd>
                  <dt>Rejected</dt><dd>{num(j.recordsRejected)}{j.recordsProcessed ? ` (${pct(ratio(j.recordsRejected, j.recordsProcessed))})` : ''}</dd>
                  <dt>Requested</dt><dd>{dateTime(j.createdAt)} by {j.requestedBy}</dd>
                  <dt>Ran</dt><dd>{dateTime(j.startedAt)} → {j.finishedAt ? dateTime(j.finishedAt) : 'in progress'} ({duration(j.startedAt, j.finishedAt)})</dd>
                </dl>
                {j.error && <p class="err"><Icon name="alert" size={14} /> {j.error}</p>}
                {j.rejectedSample.length > 0 && (
                  <div>
                    <h3 class="h">Rejected sample</h3>
                    <table><thead><tr><th>Record</th><th>Reason</th></tr></thead>
                      <tbody>{j.rejectedSample.map((r) => <tr><td class="mono">{r.ref}</td><td>{r.reason}</td></tr>)}</tbody></table>
                  </div>
                )}
                <div class="acts">
                  <button class="btn" disabled title="Needs the job runner and audit trail (Supabase)"><Icon name="refresh" size={14} /> Retry</button>
                  <button class="btn" disabled title="Needs the job runner and audit trail (Supabase)"><Icon name="x" size={14} /> Cancel</button>
                  <button class="btn" disabled title="Validation reports are generated by the job runner"><Icon name="import" size={14} /> Validation report</button>
                  <span class="muted small">Job controls are read-only in v1.</span>
                </div>
              </div>
            </details>
          </li>
        );
      })}
    </ul>
  </Panel>
</Shell>

<style>
  .chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .chips a { padding: 4px 12px; border-radius: 999px; border: 1px solid var(--border-strong); color: var(--text-2); font-size: 12.5px; }
  .chips a.on { background: var(--accent-dim); border-color: var(--accent); color: var(--text-1); }
  .chips a:hover { text-decoration: none; background: var(--surface-2); }
  .jobs { list-style: none; margin: 0; padding: 0; }
  .jobs > li { border-bottom: 1px solid var(--border); }
  .jobs > li:last-child { border-bottom: 0; }
  summary { display: flex; gap: 12px; align-items: center; padding: 11px 0; cursor: pointer; list-style: none; flex-wrap: wrap; }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: '▸'; color: var(--text-3); width: 10px; }
  details[open] summary::before { content: '▾'; }
  .what { flex: 1; min-width: 200px; }
  .tag { margin-left: 8px; font-size: 11px; padding: 1px 7px; border-radius: 4px; background: var(--surface-3); color: var(--text-2); }
  .detail { display: grid; gap: 12px; padding: 0 0 16px 22px; }
  .prog { height: 8px; border-radius: 4px; background: rgba(255, 255, 255, 0.06); overflow: hidden; max-width: 520px; }
  .prog span { display: block; height: 100%; background: linear-gradient(90deg, var(--series-1), var(--accent)); }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 0; font-size: 13px; }
  dt { color: var(--text-3); }
  dd { margin: 0; }
  .err { display: flex; gap: 6px; align-items: flex-start; color: var(--critical); font-size: 13px; }
  .h { font-size: 12px; color: var(--text-2); margin-bottom: 4px; }
  .acts { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
</style>
