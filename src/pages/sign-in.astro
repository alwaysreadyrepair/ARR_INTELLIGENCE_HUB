---
import '../styles/global.css';
import { safeNext } from '../lib/access.ts';
const MESSAGES: Record<string, string> = {
  invalid: 'That email and password don’t match.',
  role: 'Your account has no Hub access yet. Ask a Hub admin to assign you a role.',
  unavailable: 'Sign-in is unavailable right now. Try again in a minute.'
};
const error = MESSAGES[Astro.url.searchParams.get('error') ?? ''];
const next = safeNext(Astro.url.searchParams.get('next'));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sign in · ARR Intelligence Hub</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <main class="signin">
      <h1>ARR Intelligence Hub</h1>
      <p class="muted">Sign in with your Hub account.</p>
      {error && <p class="err" role="alert">{error}</p>}
      <form method="post" action="/auth/sign-in">
        <input type="hidden" name="next" value={next} />
        <label>Email<input type="email" name="email" autocomplete="username" required maxlength="320" /></label>
        <label>Password<input type="password" name="password" autocomplete="current-password" required maxlength="1024" /></label>
        <button class="btn primary" type="submit">Sign in</button>
      </form>
    </main>
  </body>
</html>
<style>
  .signin { max-width: 380px; margin: 12vh auto 0; padding: 24px; background: var(--surface-1); border-radius: var(--radius); }
  h1 { font-size: var(--fs-xl); margin: 0 0 6px; }
  form { display: grid; gap: 14px; margin-top: 18px; }
  label { display: grid; gap: 6px; font-size: var(--fs-sm); }
  input:not([type='hidden']) { font: inherit; font-size: var(--fs-lg); padding: 10px 12px; color: var(--text-1); background: var(--surface-2); border: 1px solid var(--text-2); border-radius: var(--radius-sm); }
  .btn { justify-content: center; min-height: 44px; }
  .err { color: var(--critical); font-size: var(--fs-sm); }
  @media (max-width: 420px) { .signin { margin: 32px 16px 0; } }
</style>
