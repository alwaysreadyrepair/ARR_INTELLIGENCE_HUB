{
  "name": "arr-intelligence-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run types && astro dev --port 4322",
    "build": "npm run types && astro build",
    "preview": "astro preview --port 4322",
    "check": "npm run types && astro check",
    "types": "wrangler types --strict-vars=false",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "seo:refresh": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/seo-refresh.ts",
    "seo:load": "wrangler kv key put seo:snapshot --path .seo/snapshot.json --binding SEO --local",
    "traffic:refresh": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/traffic-refresh.ts",
    "traffic:load": "wrangler kv key put traffic:snapshot --path .traffic/snapshot.json --binding TRAFFIC --local",
    "deploy": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/deploy.ts",
    "snapshot": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/snapshot.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.119.2",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.4",
    "jose": "^6.2.18",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
