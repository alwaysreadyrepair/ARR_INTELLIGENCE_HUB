{
  "name": "arr-intelligence-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4322",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist --port 4322 --compatibility-date 2025-04-01 --compatibility-flags nodejs_compat",
    "check": "astro check",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "seo:refresh": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/seo-refresh.ts",
    "seo:load": "wrangler kv key put seo:snapshot --path .seo/snapshot.json --binding SEO --local",
    "traffic:refresh": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/traffic-refresh.ts",
    "traffic:load": "wrangler kv key put traffic:snapshot --path .traffic/snapshot.json --binding TRAFFIC --local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.5.0",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.119.2",
    "astro": "^5.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.14.0"
  },
  "engines": {
    "node": ">=22"
  }
}
