{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arr-intelligence-hub",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "DATA_SOURCE": "mock", "SEO_DATA_SOURCE": "mock", "TRAFFIC_DATA_SOURCE": "mock" },
  "kv_namespaces": [
    { "binding": "SEO", "id": "local" },
    { "binding": "TRAFFIC", "id": "local" }
  ],
  "env": {
    "staging": {
      "name": "arr-intelligence-hub-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "DATA_SOURCE": "mock", "SEO_DATA_SOURCE": "snapshot", "TRAFFIC_DATA_SOURCE": "snapshot", "SUPABASE_URL": "REPLACE_ME", "SUPABASE_PUBLISHABLE_KEY": "REPLACE_ME" },
      "kv_namespaces": [
        { "binding": "SEO", "id": "REPLACE_ME" },
        { "binding": "TRAFFIC", "id": "REPLACE_ME" }
      ],
      "routes": [{ "pattern": "REPLACE_ME", "custom_domain": true }]
    },
    "production": {
      "name": "arr-intelligence-hub",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "DATA_SOURCE": "mock", "SEO_DATA_SOURCE": "snapshot", "TRAFFIC_DATA_SOURCE": "snapshot", "SUPABASE_URL": "REPLACE_ME", "SUPABASE_PUBLISHABLE_KEY": "REPLACE_ME" },
      "kv_namespaces": [
        { "binding": "SEO", "id": "REPLACE_ME" },
        { "binding": "TRAFFIC", "id": "REPLACE_ME" }
      ],
      "routes": [{ "pattern": "REPLACE_ME", "custom_domain": true }]
    }
  }
}
