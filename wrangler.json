{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arr-hub-local",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "DATA_SOURCE": "mock", "SEO_DATA_SOURCE": "mock", "TRAFFIC_DATA_SOURCE": "mock" },
  "kv_namespaces": [
    { "binding": "SEO", "id": "local" },
    { "binding": "TRAFFIC", "id": "local" }
  ],
  "env": {
    "staging": {
      "name": "arr-intelligence-hub-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "DATA_SOURCE": "mock", "SEO_DATA_SOURCE": "snapshot", "TRAFFIC_DATA_SOURCE": "snapshot", "SUPABASE_URL": "https://dienlkpgmgetkkdyduap.supabase.co", "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_oeug5oj25cO4RiWE0lz_Og__5VkIQWR" },
      "kv_namespaces": [
        { "binding": "SEO", "id": "4490db122aa6471d92f7b05a5117b9b5" },
        { "binding": "TRAFFIC", "id": "b947ea1c08e24e87bb59a9e3d627aefb" }
      ],
      "routes": [{ "pattern": "hub-staging.alwaysreadyrepair.com", "custom_domain": true }]
    },
    "production": {
      "name": "arr-hub-live",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "DATA_SOURCE": "mock", "SEO_DATA_SOURCE": "snapshot", "TRAFFIC_DATA_SOURCE": "snapshot", "SUPABASE_URL": "REPLACE_ME", "SUPABASE_PUBLISHABLE_KEY": "REPLACE_ME" },
      "kv_namespaces": [
        { "binding": "SEO", "id": "f76d2d432cc041b9aa28e723dd81027c" },
        { "binding": "TRAFFIC", "id": "cf7dbfdd108e4284ab3b94e66e388718" }
      ],
      "routes": [{ "pattern": "REPLACE_ME", "custom_domain": true }]
    }
  }
}
